#!/bin/bash

# File:   check-installed
# Author: Marco Plaitano
# Date:   31 Jan 202
# Brief:  Given a list of program names, check if they are installed on the
#         machine


_die() {
    [[ -n $1 ]] && error_msg="$1" || error_msg="Error in $(basename "$0")."
    if [[ $TERM != dumb ]]; then
        echo "$error_msg" >&2
    else
        notify-send "Error in $(basename "$0")" "$error_msg"
    fi
    exit 1
}

_help() {
    printf "Usage: %s [OPTION]...
Given a list of program names, check if they are installed on the machine

-h, --help          Show this guide and exit.
PROGRAM             Program name to check\n" "$(basename "$0")"
}

# Make sure that the script won't be executed more than once at a time.
_check_pid() {
    local PIDFILE="/tmp/$(basename "$0").pid"
    if [[ -f "$PIDFILE" ]]; then
        pid=$(cat "$PIDFILE")
        # Process found, script already running, do not execute this.
        ps -p "$pid" &>/dev/null && _die "Script already running."
    fi
    # Script wasn't running, write its pid.
    echo $$ > "$PIDFILE"
}


_check_pid

# Parse command-line arguments.
while [[ -n $1 ]]; do
    case "$1" in
        -h | --help)
            _help ; exit ;;
        *)
            if ! command -v "$1" &>/dev/null; then
                echo "Program $1 not found"
                not_found=1
            fi ;;
    esac
    shift
done

# Return error if at least one program has not been found.
if [[ -n $not_found ]]; then
    exit 1
fi
