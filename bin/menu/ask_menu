#!/bin/bash

# File:   ask_menu
# Author: Marco Plaitano
# Brief:  Run rofi with the the given options and colors.
# See:    menu


_die() {
    [[ -n $1 ]] && error_msg="$1" || error_msg="Error in $(basename "$0")."
    if [[ $TERM != dumb ]]; then
        echo "$error_msg" >&2
    else
        notify-send "Error in $(basename "$0")" "$error_msg"
    fi
    exit 1
}

# Make sure that the script won't be executed more than once at a time.
_check_pid() {
    local PIDFILE="/tmp/$(basename "$0").pid"
    if [[ -f "$PIDFILE" ]]; then
        pid=$(cat "$PIDFILE")
        # Process found, script already running, do not execute this.
        ps -p "$pid" &>/dev/null && _die "Script already running."
    fi
    # Script wasn't running, write its pid.
    echo $$ > "$PIDFILE"
}

# Check that all dependencies are met.
_check_dependencies() {
    programs=(
        rofi
    )
    check-installed ${programs[*]}
}
_check_dependencies || _die


_check_pid


################################################################################
###  ROFI APPEARANCE
################################################################################


################################################################################
###  PARSE OPTIONS
################################################################################

# Parse command line arguments.
while [[ -n $1 ]]; do
    case "$1" in
        # Prompt to display.
        -p | --prompt)
            prompt="$2"
            shift ;;
        # List of choices.
        -l | --list)
            list="$2"
            shift ;;
        # Display each option on its line.
        --multiple-lines)
            multiple_lines=1 ;;
        # Display exactly N lines.
        -nl | --num-lines)
            num_lines=$2
            shift ;;
        # Use fuzzy match.
        -F | --fuzzy)
            fuzzy="-matching fuzzy" ;;
        # Hide input characters with a *
        -P | --password)
            password="-password" ;;
        *)
            _die "Argument '$1' not recognized." ;;
    esac
    shift
done

# Default values.
num_lines=${num_lines:=0}
prompt=${prompt:="choose"}
# Delete last character from prompt if it is ':' because rofi already adds one
[[ "${prompt: -1}" == ":" ]] && prompt="${prompt::-1}"
# If requested, calculate the number of lines in the list string.
if [[ -n $multiple_lines ]] && [[ $num_lines -eq 0 ]]; then
    num_lines=$(echo -e "$list" | wc -l)
fi
# If number of elements to choose from is less than number of lines, decrease
# lines.
num_elements="$(echo -e "$list" | wc -l)"
if (( num_elements < num_lines )); then
    num_lines=$num_elements
fi

options=(
    -dmenu
    -p "$prompt"
    -i
    "$fuzzy"
    "$password"
    -theme-str '
        window {
            location: north;
            width: 100%;
        }
        listview {
            spacing: 10px;
        }
    '
)
if [[ $num_lines -eq 0 ]]; then
    options+=(
        -theme-str '
            window {
                width: 100%;
                lines: 1;
            }
            listview {
                layout: horizontal;
                spacing: 10px;
            }
            element {
                expand: true;
                padding: 8px;
            }
            element-text {
                horizontal-align: 0.5;
            }
        '
    )
else
    options+=(-l $num_lines)
fi


################################################################################
###  LAUNCH ROFI
################################################################################

# Launch rofi with a list of all system applications to run.
if [[ -z $list ]]; then
    program_list | rofi "${options[@]}" | ${SHELL:-"/bin/sh"} &

# Ask for a choice from the given list.
else
    echo $(echo -e "$list" | rofi "${options[@]}" )
fi
